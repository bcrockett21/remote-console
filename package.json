{
  "name": "remote-console",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "packages/*",
    "services/*",
    "agents/*"
  ],
  "scripts": {
    "build": "tsc -b packages/protocol services/relay-server agents/windows-agent",
    "start:relay": "node services/relay-server/dist/server.js",
    "start:agent": "node agents/windows-agent/dist/index.js",
    "test": "npm run build && node packages/protocol/dist/test-runner.js",
    "lint": "tsc -b --pretty false packages/protocol services/relay-server agents/windows-agent"
  },
  "devDependencies": {
    "@types/node": "^24.8.1",
    "typescript": "^5.9.3"
  }
}
